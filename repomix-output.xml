        'INSERT INTO users (name, email) VALUES (?, ?)',
        ['User 1', 'user1@example.com'],
      );
      db.execute(
        'INSERT INTO users (name, email) VALUES (?, ?)',
        ['User 2', 'user2@example.com'],
