      registerAllServices(container);

      expect(container.isRegistered<DatabaseService>(), isTrue);
      expect(container.isRegistered<RequestHandler>(), isTrue);
      expect(container.isRegistered<ExpensiveService>(), isTrue);
    });
  });
}

